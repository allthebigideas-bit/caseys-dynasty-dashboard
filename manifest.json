{
  "manifest_version": 3,
  "name": "Casey's Dynasty Dashboard",
  "version": "2.32.0",
  "description": "League dossier for Sleeper dynasty: graded trades, manager profiles, start/sit and waiver claims. Loads the team of whoever is logged in to Sleeper.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Casey's Dynasty Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "power",
    "notifications",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://api.sleeper.com/*",
    "https://sleeper.com/*",
    "https://keeptradecut.com/*",
    "https://api.fantasycalc.com/*",
    "https://raw.githubusercontent.com/*",
    "https://www.fantasypros.com/*",
    "https://api.github.com/*",
    "https://sleepercdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "content/sleeper.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
